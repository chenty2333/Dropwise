# Reference fragment for the prototype kernel (v6.19, x86_64).
#
# prepare_kernel.sh applies the same options with scripts/config on top of
# x86_64_defconfig.  This file is for review, not consumed automatically.
#
# The fault-injection defaults still filter out the allocations this prototype
# needs (order-0 pages, __GFP_DIRECT_RECLAIM / __GFP_HIGHMEM slab and page
# allocations).  The harness disables those filters at boot via debugfs; see
# README.md and mm/failslab.c / mm/fail_page_alloc.c in the kernel tree.

CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAIL_FUTEX=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KERNEL=y

CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_FILE_LOCKING=y
CONFIG_FUTEX=y
CONFIG_EVENTFD=y
CONFIG_MEMFD_CREATE=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y

CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y

CONFIG_MODULES=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_WERROR=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
