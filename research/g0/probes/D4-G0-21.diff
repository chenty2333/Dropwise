+// D4 observational counters. Path correlation is limited to this branch's poll.
+use deno_core::futures::future::poll_fn;
+use std::{cell::Cell, future::Future, sync::atomic::{AtomicUsize, Ordering::SeqCst}};
+thread_local! {
+    static ACTIVE: Cell<bool> = Cell::new(false);
+    static PATH: Cell<bool> = Cell::new(false);
+}
+static SITE: AtomicUsize = AtomicUsize::new(0);
+static PENDING: AtomicUsize = AtomicUsize::new(0);
+static CORRELATED: AtomicUsize = AtomicUsize::new(0);
+fn report() {
+    if let Ok(dir) = std::env::var("G0_D4_OUT") {
+        std::fs::write(format!("{}/{}.txt", dir, std::process::id()),
+            format!("{} {} {}", SITE.load(SeqCst), PENDING.load(SeqCst), CORRELATED.load(SeqCst))).unwrap();
+    }
+}
+pub fn hit() { SITE.fetch_add(1, SeqCst); report(); }
+pub fn path<F: Future>(f: F) -> impl Future<Output=F::Output> {
+    let mut f = Box::pin(f);
+    poll_fn(move |cx| {
+        let r = f.as_mut().poll(cx);
+        if r.is_pending() && ACTIVE.with(Cell::get) { PATH.with(|p| p.set(true)); }
+        r
+    })
+}
+pub fn branch<F: Future>(f: F) -> impl Future<Output=F::Output> {
+    let mut f = Box::pin(f);
+    let (mut seen, mut correlated) = (false, false);
+    poll_fn(move |cx| {
+        let previous = ACTIVE.with(|p| p.replace(true));
+        PATH.with(|p| p.set(false));
+        let r = f.as_mut().poll(cx);
+        ACTIVE.with(|p| p.set(previous));
+        if r.is_pending() {
+            if !seen { seen=true; PENDING.fetch_add(1, SeqCst); }
+            if !correlated && PATH.with(Cell::get) { correlated=true; CORRELATED.fetch_add(1, SeqCst); }
+            report();
+        }
+        r
+    })
+}
