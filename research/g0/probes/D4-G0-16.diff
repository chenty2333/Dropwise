+++ b/iroh-net/src/g0_probe.rs
@@ -0,0 +1,19 @@
+// D4 observational probe: one line per site entry / branch first Pending.
+use std::future::{Future, poll_fn};
+
+pub(super) fn hit() {
+    eprintln!("G0_D4 site_hit");
+}
+
+pub(super) fn branch<F: Future>(fut: F) -> impl Future<Output = F::Output> {
+    let mut fut = Box::pin(fut);
+    let mut seen = false;
+    poll_fn(move |cx| {
+        let result = fut.as_mut().poll(cx);
+        if result.is_pending() && !seen {
+            seen = true;
+            eprintln!("G0_D4 branch_pending");
+        }
+        result
+    })
+}
