# Proposed lettre 0.11.23 fix (not upstream): a pooled async SMTP connection whose send() was
# dropped mid-transaction reports has_broken(), so the pool closes it instead of reusing it.
--- a/src/transport/smtp/client/async_connection.rs
+++ b/src/transport/smtp/client/async_connection.rs
@@ -43,6 +43,9 @@
     stream: BufReader<AsyncNetworkStream>,
     /// Panic state
     panic: bool,
+    /// A `send` is in progress. If its future is dropped, the server may be in the
+    /// middle of a mail transaction, so the connection must not be reused.
+    sending: bool,
     /// Information about the server
     server_info: ServerInfo,
 }
@@ -138,6 +141,7 @@
         let mut conn = AsyncSmtpConnection {
             stream,
             panic: false,
+            sending: false,
             server_info: ServerInfo::default(),
         };
         // TODO log
@@ -181,6 +185,7 @@
             mail_options.push(MailParameter::Body(MailBodyParameter::EightBitMime));
         }
 
+        self.sending = true;
         try_smtp!(
             self.command(Mail::new(envelope.from().cloned(), mail_options))
                 .await,
@@ -200,11 +205,12 @@
 
         // Message content
         let result = try_smtp!(self.message(email).await, self);
+        self.sending = false;
         Ok(result)
     }
 
     pub fn has_broken(&self) -> bool {
-        self.panic
+        self.panic || self.sending
     }
 
