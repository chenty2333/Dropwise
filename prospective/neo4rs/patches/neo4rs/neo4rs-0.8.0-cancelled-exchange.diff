--- a/src/pool.rs	2026-10-19 12:55:10.788272752 +0900
+++ b/src/pool.rs	2026-10-19 12:55:10.806686350 +0900
@@ -51,6 +51,12 @@
     }
 
     async fn recycle(&self, conn: &mut Connection) -> deadpool::managed::RecycleResult<Error> {
+        // A cancelled exchange can have outstanding replies. Sending RESET and
+        // reading one reply would accept one of them as the acknowledgement and
+        // return a desynchronized connection to the pool, so discard it.
+        if conn.is_dirty() {
+            return Err(Error::UnfinishedExchange.into());
+        }
         Ok(conn.reset().await?)
     }
 }
