     /// Sends an email.
+    ///
+    /// A send that is dropped before it consumes its final 2xx reply leaves the
+    /// transport marked unusable. The caller must reconnect; the next call
+    /// returns an explicit error instead of reusing a half-finished exchange.
     pub async fn send(&mut self, email: SendableEmail) -> SmtpResult {
+        if self.poisoned {
+            return Err(Error::Client(
+                "previous send did not complete; reconnect the transport",
+            ));
+        }
+        self.poisoned = true;
+        let result = self.send_inner(email).await;
+        match result {
+            Ok(response) if response.code.severity == Severity::PositiveCompletion => {
+                self.poisoned = false;
+                Ok(response)
+            }
+            Ok(_) => Err(Error::Client("send ended at a non-final SMTP response")),
+            Err(error) => Err(error),
+        }
+    }
