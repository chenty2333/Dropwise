-impl crate::pooled_connection::PoolableConnection for AsyncMysqlConnection {}
+impl crate::pooled_connection::PoolableConnection for AsyncMysqlConnection {
+    /// mysql_async keeps `disconnected` set while a command is in flight and
+    /// clears it only when the command finished. A connection whose query was
+    /// dropped midway still has it set, with the reply possibly unread, and
+    /// must not be reused.
+    fn is_broken(&mut self) -> bool {
+        self.conn.is_disconnected()
+            || <AnsiTransactionManager as crate::TransactionManager<Self>>::is_broken_transaction_manager(self)
+    }
+}
 
